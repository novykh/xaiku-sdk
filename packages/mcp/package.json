{
  "name": "@xaiku/mcp",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/novykh/xaiku-sdk.git",
    "directory": "packages/mcp"
  },
  "private": false,
  "bin": {
    "xaiku-mcp": "./dist/bin.js"
  },
